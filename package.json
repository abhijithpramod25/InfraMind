{
  "name": "inframind",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @inframind/web dev",
    "build": "pnpm --filter @inframind/web build",
    "lint": "pnpm --filter @inframind/web lint",
    "typecheck": "pnpm --filter @inframind/web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript-eslint": "^8.19.1"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,md,css}": "prettier --write",
    "apps/web/**/*.{ts,tsx}": "eslint --fix"
  }
}
