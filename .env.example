# Local development values only. Never commit real secrets.
POSTGRES_DB=inframind
POSTGRES_USER=inframind
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000
API_PORT=8000

# API runtime configuration
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://inframind:change-me-for-local-development@postgres:5432/inframind
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:3000"]
